# Gemini API (required for scoring)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth (for online access to Docs/Drive — no service account file)
# Get Client ID and Secret: Google Cloud Console → Credentials → Create OAuth 2.0 Client ID → copy both values here.
# Then run: python run/oauth_login.py — it will save GOOGLE_ACCESS_TOKEN and GOOGLE_TOKEN_EXPIRY here (valid ~1 h; run again when expired).
# Or use refresh token (one-time paste): GOOGLE_REFRESH_TOKEN=...
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_TOKEN_EXPIRY=

# Google Drive folder with transcripts and scorecards (optional)
# ID is in the URL: https://drive.google.com/drive/folders/FOLDER_ID
# Expected subfolders: transcripts, scorecards-templates
GOOGLE_DRIVE_FOLDER_ID=

# Google Drive folder for report output (e.g. Interviews/reports)
# Set to the folder ID so reports are uploaded there. Example (carpeta por defecto):
# GOOGLE_DRIVE_REPORTS_FOLDER_ID=12K-YFnnGpvG-Pg03IXvfZeQejhXMkOIn
# ID from URL: https://drive.google.com/drive/folders/12K-YFnnGpvG-Pg03IXvfZeQejhXMkOIn
GOOGLE_DRIVE_REPORTS_FOLDER_ID=
